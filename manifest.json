{
  "manifest_version": 3,
  "name": "Night Neutral",
  "version": "1.3.0",
  "description": "A dark, gray Firefox chrome for Nova. Browser UI recedes so sites stand out.",
  "author": "Joel",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "night-neutral@firefox-better",
      "strict_min_version": "157.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "theme": {
    "colors": {
      "frame": "#000000",
      "frame_inactive": "#000000",
      "toolbar": "#000000",
      "toolbar_text": "#d4d4d4",
      "icons": "#c8c8c8",
      "icons_attention": "#e8e8e8",
      "toolbar_top_separator": "#00000000",
      "toolbar_bottom_separator": "#1a1a1a",
      "toolbar_vertical_separator": "#1a1a1a",
      "tab_selected": "#2a2a2a",
      "tab_text": "#ececec",
      "tab_background_text": "#8a8a8a",
      "tab_line": "#333333",
      "tab_loading": "#8a8a8a",
      "toolbar_field": "#0a0a0a",
      "toolbar_field_text": "#e8e8e8",
      "toolbar_field_border": "#1a1a1a",
      "toolbar_field_focus": "#141414",
      "toolbar_field_text_focus": "#f0f0f0",
      "toolbar_field_border_focus": "#333333",
      "toolbar_field_highlight": "#2a2a2a",
      "toolbar_field_highlight_text": "#f5f5f5",
      "button_background_hover": "rgba(255, 255, 255, 0.08)",
      "button_background_active": "rgba(255, 255, 255, 0.14)",
      "popup": "#1a1a1a",
      "popup_text": "#e8e8e8",
      "popup_border": "#2a2a2a",
      "popup_highlight": "#3a3a3a",
      "popup_highlight_text": "#f5f5f5",
      "sidebar": "#000000",
      "sidebar_text": "#d4d4d4",
      "sidebar_border": "#1a1a1a",
      "ntp_background": "#000000",
      "ntp_card_background": "#121212",
      "ntp_text": "#d0d0d0"
    },
    "images": {
      "additional_backgrounds": [
        {
          "linear-gradient": "to bottom, #000000 0%, #000000 100%"
        }
      ]
    },
    "properties": {
      "additional_backgrounds_alignment": ["top"],
      "additional_backgrounds_tiling": ["no-repeat"],
      "additional_backgrounds_size": ["100% 100%"],
      "backgrounds_area": "window",
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  },
  "dark_theme": {
    "colors": {
      "frame": "#000000",
      "frame_inactive": "#000000",
      "toolbar": "#000000",
      "toolbar_text": "#d4d4d4",
      "icons": "#c8c8c8",
      "icons_attention": "#e8e8e8",
      "toolbar_top_separator": "#00000000",
      "toolbar_bottom_separator": "#1a1a1a",
      "toolbar_vertical_separator": "#1a1a1a",
      "tab_selected": "#2a2a2a",
      "tab_text": "#ececec",
      "tab_background_text": "#8a8a8a",
      "tab_line": "#333333",
      "tab_loading": "#8a8a8a",
      "toolbar_field": "#0a0a0a",
      "toolbar_field_text": "#e8e8e8",
      "toolbar_field_border": "#1a1a1a",
      "toolbar_field_focus": "#141414",
      "toolbar_field_text_focus": "#f0f0f0",
      "toolbar_field_border_focus": "#333333",
      "toolbar_field_highlight": "#2a2a2a",
      "toolbar_field_highlight_text": "#f5f5f5",
      "button_background_hover": "rgba(255, 255, 255, 0.08)",
      "button_background_active": "rgba(255, 255, 255, 0.14)",
      "popup": "#1a1a1a",
      "popup_text": "#e8e8e8",
      "popup_border": "#2a2a2a",
      "popup_highlight": "#3a3a3a",
      "popup_highlight_text": "#f5f5f5",
      "sidebar": "#000000",
      "sidebar_text": "#d4d4d4",
      "sidebar_border": "#1a1a1a",
      "ntp_background": "#000000",
      "ntp_card_background": "#121212",
      "ntp_text": "#d0d0d0"
    },
    "images": {
      "additional_backgrounds": [
        {
          "linear-gradient": "to bottom, #000000 0%, #000000 100%"
        }
      ]
    },
    "properties": {
      "additional_backgrounds_alignment": ["top"],
      "additional_backgrounds_tiling": ["no-repeat"],
      "additional_backgrounds_size": ["100% 100%"],
      "backgrounds_area": "window",
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
